{
  "manifest_version": 3,
  "name": "X Reply Bot",
  "version": "0.6.1",
  "description": "Modal-based automation for X.com replies. Connects to a local Docker bot via WebSocket bridge.",
  "permissions": ["storage", "cookies", "scripting", "alarms", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.twitter.com/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "ws://host.docker.internal/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://host.docker.internal/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": [
        "src/content/icons.js",
        "src/content/modal.js",
        "src/content/index.js"
      ],
      "css": ["src/content/modal.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitterreplybot@local",
      "strict_min_version": "128.0"
    }
  }
}
