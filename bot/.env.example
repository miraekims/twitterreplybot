# Copy this file to bot/.env and fill in the values.

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to control this bot.
# Get yours by messaging @userinfobot. Required — bot ignores everyone else.
TELEGRAM_ALLOWED_USERS=

# Shared secret between the bot and the Chrome extension. ANY 16+ random
# characters, e.g. `openssl rand -hex 24`. Required.
# Paste the same value into the extension's Options page (chrome://extensions
# → X Reply Bot → Details → Extension options).
XBOT_BRIDGE_TOKEN=

# Optional — port the bridge listens on inside the container. Default 8787.
# If you change it, also update docker-compose.yml ports mapping AND the
# extension's Options page bridge URL.
# XBOT_BRIDGE_PORT=8787

# Optional — passphrase for legacy AES-GCM encryption of any leftover
# auth_token/ct0 cookies still in the SQLite DB from v0.1. Cookies live
# in Chrome now; new accounts don't store them. Safe to leave empty for
# fresh installs.
ENCRYPTION_PASSPHRASE=

# ---------- AI persona (optional) ----------
# Without these, templates are used verbatim with {author}/{name} substitution.
# With OPENAI_API_KEY set, every reply is rewritten in the campaign's persona
# voice using the original tweet as context — much harder to spot as a bot.
#
# Cost rough guide for the 1000-replies/day target (highvolume preset):
#   gpt-4o-mini  ~$0.20/day/account  (default — recommended)
#   gpt-4o       ~$5/day/account     (only if mini sounds too samey)

OPENAI_API_KEY=

# Optional: model to use. Default 'gpt-4o-mini'.
OPENAI_MODEL=gpt-4o-mini

# Optional: override base URL. Default 'https://api.openai.com/v1'.
# Useful for self-hosted proxies or OpenAI-compatible APIs (Together, Groq,
# local llama.cpp via litellm, etc).
# OPENAI_BASE_URL=https://api.openai.com/v1
