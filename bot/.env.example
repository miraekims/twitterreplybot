# Copy this file to bot/.env and fill in the values.

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to control this bot.
# Get yours by messaging @userinfobot. Required — bot ignores everyone else.
TELEGRAM_ALLOWED_USERS=

# Passphrase used to encrypt cookies/proxies in the local SQLite DB.
# Anything 12+ chars. If you lose this, you have to /connect again.
ENCRYPTION_PASSPHRASE=

# Optional: OpenAI / Anthropic key for AI-rewriting templates.
# Leave empty to use templates verbatim.
OPENAI_API_KEY=
