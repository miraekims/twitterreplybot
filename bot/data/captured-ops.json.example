{
  "_README": [
    "Copy this file to captured-ops.json and paste the captured shapes from",
    "the browser extension's Status > Diagnostics tab. The bot hot-reloads",
    "this file — no restart needed.",
    "",
    "Three sections:",
    "  _headers       — fallback static x-client-transaction-id, used ONLY if",
    "                   xclienttransaction auto-generation fails (e.g. X",
    "                   changed the ondemand bundle shape again). Optional",
    "                   but strongly recommended; without it a generation",
    "                   failure produces null and X returns 404.",
    "  SearchTimeline — captured GET shape (queryId, url, features blob)",
    "  CreateTweet    — captured POST shape (queryId, url, body)"
  ],
  "_headers": {
    "x-client-transaction-id": "PASTE_FROM_DEVTOOLS_OR_EXTENSION"
  },
  "SearchTimeline": {
    "queryId": "PASTE_FROM_EXTENSION",
    "method": "GET",
    "url": "https://x.com/i/api/graphql/PASTE_QUERY_ID/SearchTimeline?variables=...&features=...",
    "variables": "{\"rawQuery\":\"crypto\",\"querySource\":\"typed_query\",\"product\":\"Latest\",\"count\":20}",
    "features": "{...}",
    "fieldToggles": null,
    "body": null
  },
  "CreateTweet": {
    "queryId": "PASTE_FROM_EXTENSION",
    "method": "POST",
    "url": "https://x.com/i/api/graphql/PASTE_QUERY_ID/CreateTweet",
    "variables": null,
    "features": null,
    "fieldToggles": null,
    "body": "{\"variables\":{...},\"features\":{...},\"queryId\":\"...\"}"
  }
}
